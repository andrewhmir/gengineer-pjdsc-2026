# Template for the local .env file. Committed; contains no real values.
#
#   cp .env.example .env
#
# .env itself is gitignored (see .gitignore) and must never be committed.
# Replace every <angle-bracket> placeholder locally and never paste a real
# value back into this file. CI's `secrets` job scans with gitleaks and
# allowlists this file by path precisely because it is a placeholder template
# (see .gitleaks.toml), so adding a real value here also defeats the scanner.
#
# Owner-only operations and the ruleset procedure live in docs/SETUP.md.

# --- Web application -----------------------------------------------------------------
# --- No framework has been chosen yet; these keys are reserved, not read by code. ---

# Base URL the web application is served from.
APP_BASE_URL=http://localhost:8000

# Host and port the local development server binds to.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Sensor node API -----------------------------------------------------------------

# Shared token the firmware presents when posting a reading. Generate locally, e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Placeholder only; the real value belongs in .env, never in Git.
SENSOR_API_TOKEN=<generate-a-local-token>

# Base URL of the endpoint that accepts sensor readings.
SENSOR_API_BASE_URL=http://localhost:8000/api/v1

# --- Database ------------------------------------------------------------------------
# Placeholder connection string. The real host, user, and password belong in .env.

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# --- Notebook / analysis environment -------------------------------------------------
# Optional. Anything a notebook needs that is not a dependency in pyproject.toml.

# Adafruit CircuitPython bundle version used for firmware/lib. Non-secret: it is a
# release date, and it must match the pin recorded in firmware/README.md and
# firmware/lib/README.md. The 10.x variant is the default because no board has been
# chosen yet; see firmware/README.md before changing it.
CIRCUITPY_BUNDLE_VERSION=20261010
