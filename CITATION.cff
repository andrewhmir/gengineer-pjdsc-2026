repository-code: "https://github.com/andrewhmir/gengineer-pjdsc-2026"
url: "https://github.com/andrewhmir/gengineer-pjdsc-2026"
keywords:
  - public health
  - public health analytics
  - data science
  - Philippines
  - PJDSC
  - CircuitPython
  - microcontroller
  - web application
authors:
