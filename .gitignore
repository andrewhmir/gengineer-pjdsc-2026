# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- ESP-IDF ---
.cache/
eim-gui-x64.exe

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
# `uv`'s default cache lives outside the workspace, which a confined sandbox cannot
# write to; setting UV_CACHE_DIR here is the documented workaround, so the directory
# it creates must never become committable junk.
.uvcache/

# pytest's tmp_path root. On this machine tempfile.gettempdir() resolves to the
# working directory, so pytest creates pytest-of-<user>/ at the repository root
# whenever a test uses the tmp_path fixture. The unused tmp_path parameters have
# been removed from the tests; this is the safety net so a future tmp_path user
# cannot leave committable junk behind.
pytest-of-*/

# --- Secrets: never commit ---
.env
.env.local
firmware/secrets.py
*.pem
*.key

# --- Data: structure is committed, contents are not ---
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/README.md

# --- Notebook checkpoints ---
.ipynb_checkpoints/

# --- OS and editor ---
.DS_Store
Thumbs.db
*.swp

# --- Agent working artifacts ---
.worktrees/
.superpowers/
.agents/
